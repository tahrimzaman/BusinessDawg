# Copy this to .env.local and fill in. Anything starting with NEXT_PUBLIC_ is
# bundled into the client; everything else is server-only.
#
# For Hostinger production, mirror these in hPanel → Node.js → Environment.

# --- Database (Neon Postgres) ---
# Get the pooled connection string from console.neon.tech → project → Connect.
DATABASE_URL=

# --- Email (Hostinger SMTP) ---
# Free Business Email mailbox. yo@businessdawg.com sends notifications when
# someone applies via /join. Up to 100 emails/day on the free tier.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=yo@businessdawg.com
SMTP_PASS=
SMTP_FROM="BusinessDawg <yo@businessdawg.com>"
ADMIN_INBOX=yo@businessdawg.com
# Set to "true" to also be pinged on every newsletter signup.
NOTIFY_ON_SUBSCRIBE=

# --- Admin (/admin lead dashboard) ---
# Long random password. Cookie session lasts 7 days.
ADMIN_PASSWORD=
# Random secret used to derive the session token. Any string ≥32 chars.
ADMIN_SESSION_SECRET=

# --- PostHog (product analytics) ---
# Client-side (page views, button clicks)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side (booking flow, email retries, admin audit). Can be the same key
# as NEXT_PUBLIC_POSTHOG_KEY if you only use one PostHog project; or use a
# separate server-only project key to keep server volume isolated.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Security ---
# Per-app HMAC salt for IP hashing (Subscriber/Application/Booking.ipHash and
# AdminAudit.actorIpHash). Generate with `openssl rand -hex 32`. REQUIRED in
# production; dev has a fallback.
IP_HASH_SALT=

# --- Cal.com (booking) ---
NEXT_PUBLIC_CAL_USERNAME=tahrim

# --- WhatsApp click-to-chat ---
NEXT_PUBLIC_WHATSAPP_NUMBER=8801733955555

# --- Google Calendar + Meet (booking system, Phase 4) ---
# One-time setup for auto Meet links on every booking:
#   1. console.cloud.google.com → new project → enable "Google Calendar API"
#   2. OAuth consent screen: External, app name "BusinessDawg Booking",
#      scope `https://www.googleapis.com/auth/calendar.events`, add your
#      Gmail as a Test user.
#   3. Credentials → OAuth 2.0 Client ID → Web application.
#      Authorized redirect URI: http://localhost:3000/api/admin/google/callback
#      (add your production callback URL once you deploy).
#   4. Paste client ID + secret below. Restart the dev server.
#   5. Visit /admin → "Connect Google Calendar" button.
#
# Booking still works without these — visitor email just says
# "Meet link to follow" and the admin sees a "Needs Meet link" badge.
#
# Testing-mode refresh tokens expire every 7 days. Reconnect from /admin
# when the token-age badge turns amber.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/admin/google/callback
GOOGLE_OWNER_CALENDAR_ID=primary

# --- Booking system base URL ---
# Used in transactional emails for /admin/bookings/[id] deep-links and the
# visitor-facing /booking/[token]/manage reschedule + cancel link.
BOOKING_BASE_URL=http://localhost:3000

# --- Cron secret (booking reminders) ---
# Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}` to /api/booking/reminders.
# Generate with `openssl rand -base64 32` and mirror in Vercel project settings.
# Dev convenience: if unset in development, localhost requests are allowed without auth.
CRON_SECRET=

# --- Chatbot (Phase 4 — Google Gemini, free tier) ---
# Free key from https://aistudio.google.com/apikey. 1M TPM / 15 RPM / 1500 RPD.
# Used via the OpenAI-compatible endpoint so no extra SDK is needed.
# Model: gemini-2.5-flash-lite is the right pick today — 2.0-flash returns
# limit:0 on new free-tier accounts, 2.5-flash burns budget on its thinking
# mode before output. 2.5-flash-lite = fast + stable + free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Copy this to .env.local and fill in. Anything starting with NEXT_PUBLIC_ is
# bundled into the client; everything else is server-only.
#
# For Hostinger production, mirror these in hPanel → Node.js → Environment.

# --- Database (Neon Postgres) ---
# Get the pooled connection string from console.neon.tech → project → Connect.
DATABASE_URL=

# --- Email (Hostinger SMTP) ---
# Free Business Email mailbox. yo@businessdawg.com sends notifications when
# someone applies via /join. Up to 100 emails/day on the free tier.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=yo@businessdawg.com
SMTP_PASS=
SMTP_FROM="BusinessDawg <yo@businessdawg.com>"
ADMIN_INBOX=yo@businessdawg.com
# Set to "true" to also be pinged on every newsletter signup.
NOTIFY_ON_SUBSCRIBE=

# --- Admin (/admin lead dashboard) ---
# Long random password. Cookie session lasts 7 days.
ADMIN_PASSWORD=
# Random secret used to derive the session token. Any string ≥32 chars.
ADMIN_SESSION_SECRET=

# --- PostHog (product analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# --- Cal.com (booking) ---
NEXT_PUBLIC_CAL_USERNAME=tahrim

# --- WhatsApp click-to-chat ---
NEXT_PUBLIC_WHATSAPP_NUMBER=8801733955555

# --- Chatbot (Phase 4 — Google Gemini, free tier) ---
# Free key from https://aistudio.google.com/apikey. 1M TPM / 15 RPM / 1500 RPD.
# Used via the OpenAI-compatible endpoint so no extra SDK is needed.
# Model: gemini-2.5-flash-lite is the right pick today — 2.0-flash returns
# limit:0 on new free-tier accounts, 2.5-flash burns budget on its thinking
# mode before output. 2.5-flash-lite = fast + stable + free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

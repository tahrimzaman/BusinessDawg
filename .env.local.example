# --- Sanity CMS ---
# Create a project at https://sanity.io/manage, then paste the IDs.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Generate a read token in Sanity (Settings > API > Tokens). Keep server-side only.
SANITY_API_TOKEN=

# --- MailerLite (newsletter) ---
# Free tier up to 1000 subs. Get key at https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# --- Cal.com (booking) ---
# Your username becomes the slug, e.g. "tahrim" -> cal.com/tahrim
NEXT_PUBLIC_CAL_USERNAME=

# --- WhatsApp click-to-chat ---
# International format, digits only. Example: 8801733955555
NEXT_PUBLIC_WHATSAPP_NUMBER=8801733955555

# --- Chatbot (Phase 6 - gated) ---
# CHATBOT_PROVIDER=groq | huggingface | ollama
# CHATBOT_API_KEY=

# Copy this to .env.local and fill in. Anything starting with NEXT_PUBLIC_ is
# bundled into the client; everything else is server-only.
#
# For Hostinger production, mirror these in hPanel → Node.js → Environment.

# --- Database (Neon Postgres in prod, SQLite locally) ---
# Local dev:
#   DATABASE_URL="file:./prisma/dev.db"
# Production (Neon):
#   DATABASE_URL="postgresql://<user>:<pw>@<host>/<db>?sslmode=require"
# When switching to Neon, also change prisma/schema.prisma datasource
# `provider` from "sqlite" → "postgresql" and re-run `npx prisma migrate dev`.
DATABASE_URL="file:./prisma/dev.db"

# --- Resend (transactional email — lead notifications) ---
# Sign up at https://resend.com, verify businessdawg.com domain, generate API key.
RESEND_API_KEY=
# From address must be on a verified domain.
RESEND_FROM="BusinessDawg <yo@businessdawg.com>"
# Where new applications + subscribers get emailed.
ADMIN_INBOX=yo@businessdawg.com
# Set to "true" to get an email on every newsletter signup (default: silent).
NOTIFY_ON_SUBSCRIBE=

# --- Admin (/admin lead dashboard) ---
# Pick a long random password. Cookie session lasts 7 days.
ADMIN_PASSWORD=
# Random secret used to derive the session token. Any string ≥32 chars.
ADMIN_SESSION_SECRET=

# --- PostHog (product analytics) ---
# Create a project at https://posthog.com, take the Project API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sanity CMS ---
# Create a project at https://sanity.io/manage, then paste the IDs.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Generate a read token in Sanity (Settings > API > Tokens). Keep server-side only.
SANITY_API_TOKEN=

# --- Cal.com (booking) ---
# Your username becomes the slug, e.g. "tahrim" -> cal.com/tahrim
NEXT_PUBLIC_CAL_USERNAME=tahrim

# --- WhatsApp click-to-chat ---
# International format, digits only. Example: 8801733955555
NEXT_PUBLIC_WHATSAPP_NUMBER=8801733955555

# --- Chatbot (Phase 4 - gated; locked to Groq per CLAUDE.md §3 Gate #1) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-70b-versatile

# --- DEPRECATED (Phase 1 removed MailerLite — now using Resend + Neon) ---
# MAILERLITE_API_KEY=
# MAILERLITE_GROUP_ID=

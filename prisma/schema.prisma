// BusinessDawg lead capture schema.
//
// Neon Postgres (Singapore region). Local dev points at the same Neon project
// over its serverless connection — Neon scales to zero when idle, so this is
// effectively free for low-traffic dev too.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Newsletter signups + any other "give us your email" forms.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("newsletter")
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Intern / talent applications from /join.
model Application {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  portfolio String?
  note      String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────
// Booking system — Phase 2+ (self-hosted Cal.com replacement)
// ─────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id             String         @id @default(cuid())
  name           String
  email          String
  company        String?
  role           String?
  phone          String?
  intent         String
  source         String?
  startUtc       DateTime
  endUtc         DateTime
  visitorTz      String
  status         BookingStatus  @default(CONFIRMED)
  gcalEventId    String?        @unique
  meetUrl        String?
  needsMeetLink  Boolean        @default(false)
  reminder24Sent DateTime?
  tokenVersion   Int            @default(0)
  // Pre-call context — populated on booking creation, surfaced in admin.
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  referrer       String?
  landingPage    String?
  approxLocation String?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         BookingEvent[]
  customer       Customer?

  @@index([startUtc])
  @@index([status])
  @@index([email])
  // Belt to the advisory lock + overlap check's suspenders: hard-stops the
  // same email from ending up with two rows for the exact same slot if a
  // user double-clicks Submit, retries on a flaky network, or hits a race
  // around cancel-then-rebook. Route handler catches P2002 and either
  // re-confirms a CANCELLED row (legitimate rebook) or returns a friendly
  // "already booked" message.
  @@unique([startUtc, email])
}

// Promoted booking → ongoing service engagement. Owned by Tahrim's CRM
// pipeline. Hard-deleting a customer leaves the source booking intact;
// hard-deleting a booking sets bookingId to null (Customer survives).
enum CustomerStage {
  PROSPECT
  ACTIVE
  DELIVERED
  CHURNED
}

model Customer {
  id                 String        @id @default(cuid())
  bookingId          String?       @unique
  booking            Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  // Denormalized from booking so the list view is fast and surviving rows
  // still display sensibly if the booking is hard-deleted.
  name               String
  email              String
  company            String?
  phone              String?
  // Customer-specific fields Tahrim fills in post-call.
  serviceDescription String        @default("") @db.Text
  desiredDeadline    DateTime?
  pricingNotes       String?       @db.Text
  internalNotes      String?       @db.Text
  stage              CustomerStage @default(PROSPECT)
  promotedAt         DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([stage])
  @@index([email])
  @@index([desiredDeadline])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model SlotHold {
  id        String   @id @default(cuid())
  startUtc  DateTime
  endUtc    DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([startUtc])
  @@index([expiresAt])
}

model AvailabilityWindow {
  id        String  @id @default(cuid())
  dayOfWeek Int     // 0 = Sunday, 6 = Saturday
  startTime String  // "HH:mm" in owner tz
  endTime   String
  active    Boolean @default(true)

  @@index([dayOfWeek])
}

model AvailabilityException {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  blocked   Boolean  @default(true)
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

model BookingRule {
  id             String   @id @default("singleton")
  durationMin    Int      @default(15)
  minNoticeMin   Int      @default(240)
  maxHorizonDays Int      @default(21)
  bufferMin      Int      @default(15)
  maxPerDay      Int      @default(4)
  ownerTz        String   @default("Asia/Dhaka")
  meetingTitle   String   @default("BusinessDawg discovery — 15 min")
  updatedAt      DateTime @updatedAt
}

model GoogleToken {
  id            String    @id @default("singleton")
  refreshToken  String
  accessToken   String?
  expiresAt     DateTime?
  scope         String
  ownerEmail    String?
  lastRefreshAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Observability + reliability — Phase 3 (perf-audit follow-up)
// ─────────────────────────────────────────────────────────────────────────

// Emails that ALL retries failed land here, so admin can manually replay
// them (e.g. from /admin/email-debug). `status` enum-as-string so it's easy
// to grep + extend later without a migration.
//   'unsent'  — gave up after retries; needs manual replay
//   'sent'    — eventually succeeded (mostly informational; we don't write these)
//   'gave_up' — permanent failure (e.g. invalid recipient); won't be replayed
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  bodyHtml  String   @db.Text
  bodyText  String?  @db.Text
  attempts  Int      @default(0)
  lastError String?  @db.Text
  status    String   @default("unsent")
  // { type: 'visitor_confirmation' | 'admin_notification' | ..., bookingId?: string }
  context   Json?
  // Dedup key — `${type}:${bookingId}` when bookingId is present. Used as the
  // upsert key in writeOutbox so a retry of an already-failed send updates
  // the existing row (attempts++, lastError) instead of creating duplicates.
  // Nullable because some email types have no bookingId (newsletter welcome).
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Audit trail for security-relevant admin actions. Right now: login attempts
// (success + failure). Future: booking cancels by admin, customer edits, etc.
model AdminAudit {
  id          String   @id @default(cuid())
  action      String   // e.g. 'login_success' | 'login_failure'
  actorIpHash String?  // HMAC-hashed (see src/lib/security/hash.ts)
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}

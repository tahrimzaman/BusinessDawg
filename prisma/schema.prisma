// BusinessDawg lead capture schema.
//
// Neon Postgres (Singapore region). Local dev points at the same Neon project
// over its serverless connection — Neon scales to zero when idle, so this is
// effectively free for low-traffic dev too.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Newsletter signups + any other "give us your email" forms.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("newsletter")
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Intern / talent applications from /join.
model Application {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  portfolio String?
  note      String?
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}
